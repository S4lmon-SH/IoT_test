# Arduino가 측정값을 올릴 때 사용하는 비밀키입니다.
# 배포 전에 반드시 길고 무작위한 값으로 바꾸세요.
API_KEY=replace-with-a-long-random-key

# 공인 IP와, 그 IP를 가리키는 DNS 이름을 입력합니다.
PUBLIC_IP=134.185.118.90
PUBLIC_HOST=134-185-118-90.sslip.io
DASHBOARD_USER=admin
# 아래 값은 평문 비밀번호가 아니라 Caddy가 만든 해시여야 합니다.
DASHBOARD_PASSWORD_HASH='$2a$14$replace_with_caddy_hash'
